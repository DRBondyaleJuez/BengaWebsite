{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://benga-grammar.local/schemas/chapters-index.schema.json",
  "title": "Chapter index (src/data/chapters-index.json)",
  "description": "The list of chapters and their sections. It builds the sidebar, the routes (src/router/index.js) and the previous/next buttons. Guide: docs/CONTENT-GUIDE.md",
  "type": "object",
  "properties": {
    "_about": {
      "type": "string"
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chapter"
      }
    }
  },
  "required": ["chapters"],
  "additionalProperties": false,
  "$defs": {
    "titleKey": {
      "description": "Key of the title in src/locales/*.json (interface texts), e.g. chapters.chapter1.title.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "chapter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^chapter[0-9]+$",
          "examples": ["chapter1"]
        },
        "number": {
          "type": "integer",
          "minimum": 0,
          "maximum": 11
        },
        "titleKey": {
          "$ref": "#/$defs/titleKey"
        },
        "path": {
          "type": "string",
          "pattern": "^/[a-z0-9-]+$",
          "examples": ["/capitulo-1"]
        },
        "component": {
          "description": "The chapter index page in src/views, e.g. chapter-1/ChapterOneIndex.vue. Its sections are shown inside it (<router-view>).",
          "type": "string",
          "pattern": ".vue$"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      },
      "required": ["id", "number", "titleKey", "path", "sections", "component"],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "examples": ["alphabet", "class1"]
        },
        "path": {
          "type": "string",
          "pattern": "^/[a-z0-9-]+/[a-z0-9-]+$",
          "examples": ["/capitulo-1/alfabeto"]
        },
        "titleKey": {
          "$ref": "#/$defs/titleKey"
        },
        "component": {
          "description": "A page component in src/views, e.g. chapter-2/NounPracticeGame.vue.",
          "type": "string",
          "pattern": "\\.vue$"
        },
        "sectionFile": {
          "description": "A section file under src/data, e.g. sections/ch-1/syncope.json, drawn by SectionPage.vue (or NounClassPage.vue for \"layout\": \"noun-class\").",
          "type": "string",
          "pattern": "\\.json$"
        }
      },
      "required": ["id", "path", "titleKey"],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["component"]
        },
        {
          "required": ["sectionFile"]
        }
      ]
    }
  }
}
