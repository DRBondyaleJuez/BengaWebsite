  "blocks": [
    {
      "type": "heading",
      "id": "triphthongs-intro",
      "text": {
        "es": "Triptongos",
        "en": "Triphthongs"
      }
    },
    {
      "type": "paragraph",
      "text": {
        "es": "Los triptongos son combinaciones de tres vocales que mantienen su sonido continuo.",
        "en": "Triphthongs are combinations of three vowels that keep a continuous sound."
      }
    },
    {
      "type": "note",
      "variant": "info",
      "text": {
        "es": "Estas y semejantes combinaciones se hallarán en gran número y variedad al registrar la conjugación de los verbos regulares en su voz pasiva.",
        "en": "These and similar combinations will be found in great number and variety when going through the conjugation of regular verbs in the passive voice."
      }
    },
