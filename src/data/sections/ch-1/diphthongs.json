      "type": "paragraph",
      "text": {
        "es": "Podemos combinar dos vocales anteriormente descritas para formar diptongos. Algunos de los comunes en Benga son los siguientes:.",
        "en": "We can combine two of the vowels described above to form diphthongs. Some of the common ones in Benga are the following:"
      }
    },
    {
      "type": "heading",
      "id": "simple-diphthongs"
    },
    {
      "type": "sounds",
      "items": [
        {
          "label": "ai",
          "soundsLike": {
            "es": "ai como en 'gaita'",
            "en": "ai in aisle",
            "fr": "aille dans paille"
          },
          "examples": [
            {
              "word": "tekai",
              "meaning": {
                "es": "cáscara",
                "en": "shell, husk"
              }
            }
          ]
        },
        {
          "label": "au",
          "soundsLike": {
            "es": "au como en 'causa'",
            "en": "ow in bow",
            "fr": "au dans cause"
          },
          "examples": [
            {
              "word": "au",
              "meaning": {
                "es": "pronombre y signo negativo",
                "en": "pronoun and negative sign"
              }
            }
          ]
        },
        {
          "label": "iu",
          "soundsLike": {
            "es": "iu como en 'ciudad'",
            "en": "ew in few",
            "fr": "ieu dans dieu"
          },
          "examples": [
            {
              "word": "viu",
              "meaning": {
                "es": "obscuridad",
                "en": "darkness"
              }
            }
          ]
        },
        {
          "label": "oi",
          "soundsLike": {
            "es": "oi como en 'boina'",
            "en": "oy in boy",
            "fr": "oi dans voix"
          },
          "examples": [
            {
              "word": "mboi",
              "meaning": {
                "es": "miel",
                "en": "honey"
              }
            }
          ]
        },
        {
          "label": "ūa",
          "soundsLike": {
            "es": "úa como 'puas'",
            "en": "wa in water",
            "fr": "oua dans pouah"
          },
          "examples": [
            {
              "word": "mūana",
              "meaning": {
                "es": "niño, hijo",
                "en": "child, son"
              }
            }
          ]
        },
        {
          "label": "ūe",
          "soundsLike": {
            "es": "úe en 'acentiúe'",
            "en": "we in wet",
            "fr": "ue dans gueule"
          },
          "examples": [
            {
              "word": "babūe",
              "meaning": {
                "es": "inteligible",
                "en": "intelligible"
              }
            }
          ]
        },
        {
          "label": "ūâ",
          "soundsLike": {
            "es": "uo como en 'cuota'",
            "en": "wa in wand",
            "fr": "oua dans guano"
          },
          "examples": [
            {
              "word": "ūâūâ",
              "meaning": {
                "es": "aprisa, pronto",
                "en": "quickly, soon"
              }
            }
          ]
        },
        {
          "label": "ūē",
          "soundsLike": {
            "es": "ue en 'cueva'",
            "en": "we in well",
            "fr": "ue dans pluie"
          },
          "examples": [
            {
              "word": "hūē",
              "meaning": {
                "es": "nosotros",
                "en": "we"
              }
            }
          ]
        },
        {
          "label": "ūi",
          "soundsLike": {
            "es": "ui en 'cuita'",
            "en": "ui in suite",
            "fr": "ui dans fruit"
