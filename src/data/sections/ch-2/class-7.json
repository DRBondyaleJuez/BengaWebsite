      "text": {
        "es": "Conceptos Clave"
      }
    },
    {
      "type": "concepts",
      "items": [
        {
          "title": {
            "es": "Invariable"
          },
          "text": {
            "es": "En esta clase, la forma del nombre no cambia entre singular y plural."
          }
        },
        {
          "title": {
            "es": "Contexto gramatical"
          },
          "text": {
            "es": "El número se infiere por los modificadores, los adjetivos o el contexto de la frase."
          }
        },
        {
          "title": {
            "es": "Gran grupo"
          },
          "text": {
            "es": "Muchos de los nombres que empiezan por consonante y casi todos los que comienzan con doble consonante siguen esta regla."
          }
        }
      ]
    },
    {
      "type": "heading",
      "id": "practice",
      "text": {
        "es": "Para Practicar"
      }
    },
    {
      "type": "practice",
      "items": [
        {
          "es": "Observa que la forma del nombre no cambia entre singular y plural."
        },
        {
          "es": "Busca el número por el adjetivo o por el contexto en la oración."
        },
        {
          "es": "Memoriza ejemplos comunes para reconocer la clase rápidamente."
        }
      ]
