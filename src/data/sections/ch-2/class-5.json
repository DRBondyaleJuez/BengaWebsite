{
  "id": "ch2-noun-class-5",
  "chapter": 2,
  "layout": "noun-class",
  "title": {
    "es": "Clase 5"
  },
  "subtitle": {
    "es": "mo → ba"
  },
  "source": {
    "pdfPage": 12
