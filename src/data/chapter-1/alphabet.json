{
  "sectionId": "alphabet",
  "title": {
    "es": "Del Alfabeto",
    "en": "The Alphabet",
    "fr": "L'Alphabet"
  },
  "introduction": {
    "es": "El alfabeto benga consta de veintitrés letras. El acento marca su sonido peculiar solo en las vocales â, ē, ū que denominamos largas. La elisión es muy frecuente al fin del vocablo. Todo lo que se pronuncia se escribe, y viceversa, todo lo que se escribe se lee y pronuncia claro y distinto, como en castellano.",
    "en": "The Benga alphabet consists of twenty-three letters. The accent marks their peculiar sound only on the vowels â, ē, ū, which we call long. Elision is very frequent at the end of a word. Everything that is pronounced is written, and conversely, everything that is written is read and pronounced clearly and distinctly, as in Spanish."
  },
  "consonantsDescription": {
    "es": "Carece de las consonantes c, ch, ll, ñ, q, r, x, z del castellano.",
    "en": "It lacks the Spanish consonants c, ch, ll, ñ, q, r, x, z."
  },
  "lettersList": {
    "es": "a, â, b, d, e, ē, f, g, h, i, j, k, l, m, n, o, p, s, t, u, ū, w, y",
    "en": "a, â, b, d, e, ē, f, g, h, i, j, k, l, m, n, o, p, s, t, u, ū, w, y"
  },
  "vowelsInfo": {
    "es": "El benga admite nueve sonidos vocales: a, â, e, ē, i, o, u, ū, y",
    "en": "Benga has nine vowel sounds: a, â, e, ē, i, o, u, ū, y"
  },
