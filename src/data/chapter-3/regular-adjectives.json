      "classType": {
        "es": "Clase 6"
      },
      "nounClassRule": {
        "es": "Empieza con 'v' en singular y por 'l' en plural"
      },
      "adjectiveClassRule": {
        "es": "Sustituye la primera sílaba por 'vi' en singular y por 'lo' en plural"
      },
      "nounExample": "Vitua",
      "adjectiveExample": "viyamu",
      "singular": {
        "bengaForm": "Vitua viyamu",
        "highlight": "viy",
