{
  "sectionId": "variable-adjectives",
  "title": {
    "es": "Adjetivos Variables"
  },
  "subtitle": {
    "es": "Flexión según clase nominal"
  },
  "overview": {
    "es": "Los adjetivos variables toman su forma correspondiente a singular y plural, concordando en clasificación con los nombres que califican."
  },
  "classes": [
    {
      "classId": 1,
      "classType": {
        "es": "Clase 1"
      },
      "nounClassRule": {
        "es": "Empieza con 'e' o 'y' en singular y antepone 'be' o 'bi' en plural"
      },
      "adjectiveClassRule": {
        "es": "Sustituye la primera sílaba por 'e' o 'ey' en singular y añade 'b' al comienzo en plural"
      },
      "nounExample": "Epokolo",
      "adjectiveExample": "eyamu",
      "singular": {
        "bengaForm": "Epokolo eyamu",
        "highlight": "ey",
        "spanishTranslation": {
          "es": "Sombrero bueno"
        },
        "audioId": "epokolo-eyamu"
      },
      "plural": {
        "bengaForm": "Bepokolo beyamu",
        "highlight": "bey",
        "spanishTranslation": {
          "es": "Sombreros buenos"
        },
        "audioId": "bepokolo-beyamu"
      }
    },
    {
      "classId": 2,
      "classType": {
        "es": "Clase 2"
      },
      "nounClassRule": {
        "es": "Empieza con 'i' o 'di' en singular y se cambia por 'ma' en plural"
      },
      "adjectiveClassRule": {
        "es": "Sustituye la primera sílaba por 'i' o 'iy' en singular y por 'ma' o 'may' en plural"
      },
      "nounExample": "Ibongo",
      "adjectiveExample": "iyamu",
      "singular": {
        "bengaForm": "Ibongo iyamu",
        "highlight": "iy",
        "spanishTranslation": {
          "es": "Desembarcadero bueno"
        },
        "audioId": "ibongo-iyamu"
      },
      "plural": {
        "bengaForm": "Mabongo maiyamu",
        "highlight": "maiy",
        "spanishTranslation": {
          "es": "Desembarcaderos buenos"
        },
        "audioId": "mabongo-maiyamu"
      }
    },
    {
      "classId": 3,
      "classType": {
        "es": "Clase 3"
      },
      "nounClassRule": {
        "es": "Empieza con 'u' o 'mū' en singular y se cambia por 'me' o 'mi' en plural"
      },
      "adjectiveClassRule": {
        "es": "Sustituye la primera sílaba por 'u' o 'uy' en singular y por 'me' o 'mey' en plural"
      },
      "nounExample": "Ubâki",
      "adjectiveExample": "uyamu",
      "singular": {
        "bengaForm": "Ubâki uyamu",
        "highlight": "uy",
        "spanishTranslation": {
          "es": "Hacha buena"
        },
        "audioId": "ub_a_ki-uyamu"
      },
      "plural": {
        "bengaForm": "Mebâki meyamu",
        "highlight": "mey",
        "spanishTranslation": {
          "es": "Hachas buenas"
        },
        "audioId": "meb_a_ki-meyamu"
      }
    },
    {
      "classId": 4,
      "classType": {
        "es": "Clase 4"
      },
      "nounClassRule": {
        "es": "Empieza con 'bo' o 'bū' en singular y se cambia por 'mi' en plural"
      },
      "adjectiveClassRule": {
        "es": "Sustituye la primera sílaba por 'bo' o 'boy' en singular y por 'me' o 'mey' en plural"
      },
      "nounExample": "Boho",
      "adjectiveExample": "boyamu",
      "singular": {
        "bengaForm": "Boho boyamu",
        "highlight": "boy",
