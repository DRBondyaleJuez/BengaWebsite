        },
        "audioId": "boho-boyamu"
      },
      "plural": {
        "bengaForm": "Mioho meyamu",
        "highlight": "mey",
        "spanishTranslation": {
          "es": "Caras buenas"
        },
        "audioId": "mioho-meyamu"
      }
    },
    {
      "classId": 5,
      "classType": {
        "es": "Clase 5"
      },
      "nounClassRule": {
        "es": "Empieza con 'mo' en singular y se cambia por 'ba' en plural"
      },
      "adjectiveClassRule": {
        "es": "Sustituye la primera sílaba por 'u' o 'uy' en singular y por 'ba' o 'baiy' en plural"
      },
      "nounExample": "Moto",
      "adjectiveExample": "uyamu",
      "singular": {
        "bengaForm": "Moto uyamu",
        "highlight": "uy",
