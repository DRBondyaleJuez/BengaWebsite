      }
    },
    {
      "classId": 7,
      "classType": {
        "es": "Clase 7"
      },
      "nounClassRule": {
        "es": "Empieza con consonantes no mencionadas en las otras clases o combinaciones de consonantes en singular y no cambian en plural"
      },
      "adjectiveClassRule": {
        "es": "Sustituye la primera sílaba por 'e' en singular y por 'i' en plural"
      },
      "nounExample": "Ndabo",
      "adjectiveExample": "eyamu",
      "singular": {
        "bengaForm": "Ndabo eyamu",
        "highlight": "ey",
        "spanishTranslation": {
