  "ordinalNumbers": {
    "title": {
      "es": "Números ordinales",
      "en": "Ordinal numbers",
      "fr": "Nombres ordinaux"
    },
    "overview": {
      "es": "Los ordinales propiamente dichos no los conocen los Bengas; sin embargo, hay un modo muy general de expresarlos. Este método consiste en prefijar el número cardinal en caso posesivo.",
      "en": "The Bengas do not have ordinals as such; however, there is a very general way of expressing them. This method consists of prefixing the cardinal number in the possessive case.",
      "fr": "Les Bengas ne connaissent pas les ordinaux à proprement parler ; il existe toutefois une manière très générale de les exprimer. Cette méthode consiste à préfixer le nombre cardinal au cas possessif."
    },
    "structure": {
      "es": "Preposición de genitivo + Número cardinal",
      "en": "Genitive preposition + Cardinal number",
      "fr": "Préposition du génitif + Nombre cardinal"
    },
