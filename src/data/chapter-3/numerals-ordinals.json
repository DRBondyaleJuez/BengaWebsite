  "numeralInflections": {
    "title": {
      "es": "Inflexiones de los cinco primeros numerales",
      "en": "Inflections of the first five numerals"
    },
    "overview": {
      "es": "Los cinco primeros numerales (1-5) son variables y, como todos los adjetivos variables, están sujetos a cambio y modificación según la concordancia con cada una de las 7 clases de sustantivos.",
      "en": "The first five numerals (1-5) are variable and, like all variable adjectives, are subject to change and modification according to agreement with each of the 7 noun classes."
    },
