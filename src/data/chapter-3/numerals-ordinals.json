  "specialNumeralUse": {
    "title": {
      "es": "Usos particulares de los numerales",
      "en": "Particular uses of numerals",
      "fr": "Emplois particuliers des numéraux"
    },
    "gestureMethod": {
      "es": "Método de los dedos: Mostrar los dedos levantados y esperar a que los oyentes digan el número en voz alta",
      "en": "Finger method: Hold up the raised fingers and wait for the listeners to say the number aloud",
      "fr": "Méthode des doigts : montrer les doigts levés et attendre que les auditeurs disent le nombre à voix haute"
    },
    "repetitionMethod": {
      "es": "Método de repetición rápida: Repetir una palabra diez, quince o veinte veces con mucha prisa para indicar número, calidad o cantidad extraordinaria",
      "en": "Rapid repetition method: Repeat a word ten, fifteen or twenty times in great haste to indicate an extraordinary number, quality or quantity",
      "fr": "Méthode de répétition rapide : répéter un mot dix, quinze ou vingt fois très vite pour indiquer un nombre, une qualité ou une quantité extraordinaire"
    },
    "repCountWords": [
      {
        "word": "Njo",
        "meaning": {
          "es": "Vez",
          "en": "Time (occasion)",
          "fr": "Fois"
        },
        "example": "Njo ininge?",
        "spanishMeaning": {
          "es": "¿Cuántas veces?",
          "en": "How many times?",
          "fr": "Combien de fois ?"
        }
      }
    ]
  },
  "notes": [
    {
      "es": "El número diez con sus múltiplos se usan como números redondos, y los nombres van después en caso posesivo",
      "en": "The number ten and its multiples are used as round numbers, and the nouns follow in the possessive case",
      "fr": "Le nombre dix et ses multiples s'emploient comme nombres ronds, et les noms viennent ensuite au cas possessif"
    },
    {
      "es": "Ejemplo: 'diez espejos' (dyom dya dejeno) literalmente significa 'diez de espejos'",
      "en": "Example: 'ten mirrors' (dyom dya dejeno) literally means 'ten of mirrors'",
      "fr": "Exemple : « dix miroirs » (dyom dya dejeno) signifie littéralement « dix de miroirs »"
    },
    {
      "es": "Cuando la cuenta incluye unidades, decenas y centenas, el nombre se repite",
      "en": "When the count includes units, tens and hundreds, the noun is repeated",
      "fr": "Lorsque le compte comprend des unités, des dizaines et des centaines, le nom est répété"
    },
    {
      "es": "Ejemplo: 'ciento veinticinco pañuelos' = Kama bevéléhi pâkâ, na mabo mabale na bevelehi betano",
      "en": "Example: 'one hundred and twenty-five handkerchiefs' = Kama bevéléhi pâkâ, na mabo mabale na bevelehi betano",
      "fr": "Exemple : « cent vingt-cinq mouchoirs » = Kama bevéléhi pâkâ, na mabo mabale na bevelehi betano"
    }
  ]
}
